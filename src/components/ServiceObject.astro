---
interface Props { kind: 'software' | 'web' | 'automation'; }
const { kind } = Astro.props;
const metal = `metal-${kind}`;
const edge = `edge-${kind}`;
---
<div class={`service-object service-object--${kind}`} aria-hidden="true">
  <svg viewBox="0 0 360 200" fill="none">
    <defs>
      <linearGradient id={metal} x1="60" y1="20" x2="270" y2="190" gradientUnits="userSpaceOnUse"><stop stop-color="#fbfdf6"/><stop offset=".42" stop-color="#d7dfd2"/><stop offset=".72" stop-color="#9daa9a"/><stop offset="1" stop-color="#e7ece2"/></linearGradient>
      <linearGradient id={edge} x1="80" y1="110" x2="260" y2="170" gradientUnits="userSpaceOnUse"><stop stop-color="#72816e"/><stop offset=".5" stop-color="#c3cebc"/><stop offset="1" stop-color="#485744"/></linearGradient>
      <radialGradient id={`shadow-${kind}`}><stop stop-color="#34432c" stop-opacity=".22"/><stop offset="1" stop-color="#34432c" stop-opacity="0"/></radialGradient>
    </defs>
    <ellipse cx="180" cy="173" rx="145" ry="24" fill={`url(#shadow-${kind})`}/>
    {kind === 'software' && <>
      <path d="m60 127 120-64 120 64-120 64Z" stroke="#85937e" stroke-opacity=".35" stroke-dasharray="3 5"/>
      <g class="object-part object-part--one">
        <path d="m66 112 57-30 57 30v17l-57 30-57-30Z" fill={`url(#${edge})`}/><path d="m66 112 57-30 57 30-57 30Z" fill={`url(#${metal})`} stroke="#f4f7ed"/>
        <path d="m91 113 31-16 32 16-31 16Z" fill="#394a34"/><path d="m112 111 8-4 10 5-8 4Z" fill="#dcf89c"/>
      </g>
      <g class="object-part object-part--two">
        <path d="m180 112 57-30 57 30v17l-57 30-57-30Z" fill={`url(#${edge})`}/><path d="m180 112 57-30 57 30-57 30Z" fill={`url(#${metal})`} stroke="#f4f7ed"/>
        <path d="m211 111 23-12m-12 18 23-12m-12 18 23-12" stroke="#65785a" stroke-width="4" stroke-linecap="round"/>
      </g>
      <g class="object-part object-part--three">
        <path d="m123 63 57-30 57 30v17l-57 30-57-30Z" fill={`url(#${edge})`}/><path d="m123 63 57-30 57 30-57 30Z" fill={`url(#${metal})`} stroke="#f4f7ed"/>
        <path d="m152 64 28-15 29 15-28 15Z" fill="#dcf89c" stroke="#8a9d74"/><path d="m169 64 8 4 15-8" stroke="#435b35" stroke-width="3" stroke-linecap="round"/>
      </g>
    </>}
    {kind === 'web' && <>
      <g class="object-part object-part--one"><path d="m64 126 114-61 119 61v9l-114 61-119-61Z" fill={`url(#${edge})`}/><path d="m64 126 114-61 119 61-114 61Z" fill={`url(#${metal})`} stroke="#f4f7ed"/></g>
      <g class="object-part object-part--two"><path d="m77 99 101-54 106 54v8l-101 54L77 107Z" fill={`url(#${edge})`}/><path d="m77 99 101-54 106 54-101 54Z" fill={`url(#${metal})`} stroke="#f4f7ed"/><path d="m103 101 32-17 32 17-32 17Zm47-25 27-14 33 17-27 14Z" fill="#819477"/><path d="m159 125 69-37m-57 44 69-37" stroke="#a4b698" stroke-width="4" stroke-linecap="round"/></g>
      <g class="object-part object-part--three"><path d="m90 65 88-47 93 47v8l-88 47-93-47Z" fill={`url(#${edge})`}/><path d="m90 65 88-47 93 47-88 47Z" fill={`url(#${metal})`} stroke="#f4f7ed"/><path d="m102 71 88-47" stroke="#a4b29b"/><path d="m121 77 59-31 63 33-59 31Z" fill="#35472e"/><path d="m140 78 36-19m-25 25 23-12" stroke="#dcf89c" stroke-width="4" stroke-linecap="round"/><path d="m178 94 26-14 13 7-26 14Z" fill="#dcf89c"/></g>
    </>}
    {kind === 'automation' && <>
      <path d="m72 112 62 34 98-52 57 31" stroke="#8e9e85" stroke-width="9" stroke-linecap="round" stroke-linejoin="round"/>
      <path class="object-connection" d="m72 112 62 34 98-52 57 31" stroke="#dcf89c" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" pathLength="1"/>
      {[{x:28,y:69},{x:134,y:59},{x:239,y:84}].map((p,i) => <g class={`object-part object-part--${['one','two','three'][i]}`}>
        <path d={`m${p.x} ${p.y+23} 43-23 45 23v15l-43 23-45-23Z`} fill={`url(#${edge})`}/><path d={`m${p.x} ${p.y+23} 43-23 45 23-43 23Z`} fill={`url(#${metal})`} stroke="#f4f7ed"/>
        <ellipse cx={p.x+44} cy={p.y+23} rx="19" ry="10" fill={i===1?'#dcf89c':'#3d5036'} stroke="#8c9f7b"/>
        <circle cx={p.x+44} cy={p.y+23} r="4" fill={i===1?'#435b35':'#dcf89c'}/>
      </g>)}
    </>}
  </svg>
</div>
