---
interface Props { kind: 'software' | 'web' | 'automation'; }
const { kind } = Astro.props;
---
<div class={`service-object service-object--${kind}`} aria-hidden="true">
  <svg class="service-diagram" viewBox="0 0 360 200" fill="none" focusable="false">
    <!-- Shared drafting marks keep the three drawings in the same visual family. -->
    <g class="diagram-guides">
      <path d="M24 48V24h24m264 24V24h-24M24 152v24h24m264-24v24h-24" />
      <path d="M18 100h12m300 0h12M180 18v12m0 140v12" />
      {[60, 100, 140, 180, 220, 260, 300].map(x =>
        [40, 80, 120, 160].map(y => <circle cx={x} cy={y} r=".7" fill="currentColor" stroke="none" />)
      )}
    </g>

    {kind === 'software' && <>
      <path class="diagram-construction" d="M52 42h236v116H52zM108 42v116M108 80h180" />
      <g class="diagram-assembly diagram-assembly--base">
        <rect class="diagram-offset" x="58" y="51" width="232" height="112" rx="7" />
        <rect class="diagram-paper" x="52" y="45" width="232" height="112" rx="7" />
        <path class="diagram-rule" d="M52 69h232M102 69v88" />
        <g class="diagram-ink">
          <path d="m67 55 4 4-4 4m11 0h7" stroke-width="1.4" />
          <path d="M66 85h20M66 97h13M66 109h17" opacity=".5" />
        </g>
        <circle class="diagram-accent" cx="270" cy="57" r="3" />
        <rect class="diagram-wash" x="114" y="81" width="72" height="62" rx="4" />
        <path class="diagram-rule" d="M125 94h27m-27 7h17M125 131h49" />
        <path class="diagram-bars" d="M132 125v-10m12 10v-16m12 16v-9m12 9v-23" />
        <rect class="diagram-slot" x="198" y="81" width="72" height="62" rx="4" />
        <path class="diagram-rule" d="M227 112h14m-7-7v14" />
      </g>
      <g class="diagram-assembly diagram-assembly--module">
        <rect class="diagram-dark" x="208" y="72" width="72" height="62" rx="5" />
        <rect class="diagram-accent" x="202" y="66" width="72" height="62" rx="5" />
        <path class="diagram-ink" d="M214 80h25m-25 7h17" />
        <path class="diagram-ink" d="m217 105 5 5 9-10m9 5h19" />
        <circle class="diagram-ink" cx="260" cy="80" r="3" />
      </g>
      <path class="diagram-trace diagram-ink" d="M90 176h180" pathLength="1" />
    </>}

    {kind === 'web' && <>
      <path class="diagram-construction" d="M46 41h248v120H46zM46 73h248M218 41v120" />
      <g class="diagram-assembly diagram-assembly--base">
        <rect class="diagram-offset" x="50" y="40" width="236" height="124" rx="7" />
        <rect class="diagram-paper" x="44" y="34" width="236" height="124" rx="7" />
        <path class="diagram-dark" d="M51 34h222a7 7 0 0 1 7 7v19H44V41a7 7 0 0 1 7-7Z" />
        <g fill="#a8b99b"><circle cx="58" cy="47" r="2" /><circle cx="66" cy="47" r="2" /><circle cx="74" cy="47" r="2" /></g>
        <rect x="109" y="41" width="109" height="12" rx="3" fill="#ffffff12" />
        <text class="diagram-address" x="164" y="50" text-anchor="middle">tu-negocio.es</text>
        <path class="diagram-heading" d="M61 79h54m-54 9h39" />
        <path class="diagram-rule" d="M61 103h71m-71 6h56" />
        <rect class="diagram-dark" x="61" y="120" width="42" height="13" rx="2" />
        <path stroke="#dcf89c" d="M72 126.5h19m-3-3 3 3-3 3" />
        <rect class="diagram-wash" x="153" y="73" width="109" height="70" rx="3" />
        <path class="diagram-rule" d="M153 108h109m-54-35v70" />
        <circle class="diagram-ink" cx="208" cy="108" r="26" />
        <path class="diagram-accent" d="M182 108a26 26 0 0 1 26-26v26Z" />
        <path class="diagram-ink" d="m192 124 31-31m-9 0h9v9" />
      </g>
      <g class="diagram-assembly diagram-assembly--device">
        <rect class="diagram-dark" x="246" y="83" width="57" height="93" rx="8" />
        <rect class="diagram-paper" x="242" y="79" width="57" height="93" rx="8" />
        <path class="diagram-ink" d="M263 85h15" />
        <rect class="diagram-accent" x="249" y="95" width="43" height="34" rx="2" />
        <path class="diagram-ink" d="m262 118 15-15m-8 0h8v8" />
        <path class="diagram-ink" d="M250 138h28m-28 6h20" />
        <rect class="diagram-dark" x="250" y="153" width="25" height="8" rx="2" />
      </g>
      <path class="diagram-trace diagram-ink" d="M88 176h141" pathLength="1" />
    </>}

    {kind === 'automation' && <>
      <g class="diagram-rule">
        <path d="M82 62h31a12 12 0 0 1 12 12v14a12 12 0 0 0 12 12h18M82 138h31a12 12 0 0 0 12-12v-14a12 12 0 0 1 12-12h18" />
        <path d="M206 100h18a12 12 0 0 0 12-12V74a12 12 0 0 1 12-12h30M206 100h18a12 12 0 0 1 12 12v14a12 12 0 0 0 12 12h30" />
      </g>
      <g class="diagram-flow">
        <path class="diagram-trace" d="M82 62h31a12 12 0 0 1 12 12v14a12 12 0 0 0 12 12h87a12 12 0 0 0 12-12V74a12 12 0 0 1 12-12h30" pathLength="1" />
        <path class="diagram-trace" d="M82 138h31a12 12 0 0 0 12-12v-14a12 12 0 0 1 12-12h87a12 12 0 0 1 12 12v14a12 12 0 0 0 12 12h30" pathLength="1" />
      </g>
      <g class="diagram-assembly diagram-assembly--input">
        <rect class="diagram-paper" x="40" y="41" width="44" height="42" rx="7" />
        <path class="diagram-ink" d="M53 53h18v13H60l-7 5V53Zm4 5h10m-10 4h6" />
        <rect class="diagram-paper" x="40" y="117" width="44" height="42" rx="7" />
        <path class="diagram-ink" d="M53 127h18v20H53zM53 134h18m-12 0v13m-6-7h18" />
      </g>
      <g class="diagram-assembly diagram-assembly--base">
        <rect class="diagram-offset" x="153" y="73" width="62" height="62" rx="12" />
        <rect class="diagram-dark" x="149" y="69" width="62" height="62" rx="12" />
        <path stroke="#dcf89c" stroke-width="1.8" d="M166 100h8m0 0 10-12h10m-20 12 10 12h10" />
        <g fill="#dcf89c"><circle cx="166" cy="100" r="3" /><circle cx="194" cy="88" r="3" /><circle cx="194" cy="112" r="3" /></g>
      </g>
      <g class="diagram-assembly diagram-assembly--output">
        <rect class="diagram-paper" x="276" y="41" width="44" height="42" rx="7" />
        <path class="diagram-ink" d="M288 53h20v15h-20zm0 0 10 8 10-8" />
        <rect class="diagram-accent" x="276" y="117" width="44" height="42" rx="7" />
        <path class="diagram-ink" d="M288 128h20v20h-20zm0 6h20m-15-9v6m10-6v6m-10 10 3 3 6-7" />
      </g>
      <g class="diagram-ports"><circle cx="125" cy="100" r="3" /><circle cx="236" cy="100" r="3" /></g>
    </>}
  </svg>

  <!-- Compact compositions stay legible in the short mobile chapter headers. -->
  <svg class="service-glyph" viewBox="0 0 48 32" fill="none" focusable="false">
    {kind === 'software' && <>
      <rect class="diagram-ink" x="5" y="6" width="29" height="22" rx="3" />
      <path class="diagram-rule" d="M5 12h29M13 12v16" />
      <rect class="diagram-accent" x="25" y="3" width="16" height="15" rx="3" />
      <path class="diagram-ink" d="m29 10 3 3 5-6" />
    </>}
    {kind === 'web' && <>
      <rect class="diagram-ink" x="4" y="4" width="31" height="22" rx="3" />
      <path class="diagram-rule" d="M4 10h31M10 16h13m-13 5h9" />
      <rect class="diagram-accent" x="30" y="11" width="13" height="19" rx="3" />
      <path class="diagram-ink" d="M34 15h5m-4 11h3" />
    </>}
    {kind === 'automation' && <>
      <path class="diagram-ink" d="M8 16h12m8 0h5V7h8m-8 9v9h8" />
      <rect class="diagram-dark" x="17" y="9" width="14" height="14" rx="4" />
      <circle class="diagram-paper" cx="6" cy="16" r="4" />
      <circle class="diagram-accent" cx="41" cy="7" r="4" />
      <circle class="diagram-paper" cx="41" cy="25" r="4" />
      <path stroke="#dcf89c" d="m21 16 2 2 4-4" />
    </>}
  </svg>
</div>
