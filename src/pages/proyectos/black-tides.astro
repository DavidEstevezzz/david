import Shell from '../../layouts/Shell.astro';
import '../../styles/case.css';
const moments = [
 {title:'Entrar en el mundo', image:'hero-poster.webp', text:'Una primera escena establece el tono, presenta el juego e invita a explorar.'},
 {title:'Explorar la nave', image:'ship-corridor-960.webp', text:'El recorrido enlaza escenarios, personaje y propuesta de juego sin interrumpir la lectura.'},
 {title:'Descubrir la transformación', image:'organic-growth-960.webp', text:'La atmósfera cambia y la infección introduce el giro visual de la experiencia.'},
