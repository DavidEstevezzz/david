---
import Shell from '../layouts/Shell.astro';
import '../styles/case.css';
import ArrowUpRight from '../components/ArrowUpRight.astro';
import BrandMark from '../components/BrandMark.astro';
import Icon from '../components/Icon.astro';
---
<Shell title="Página no encontrada — David Estévez" description="La página que buscabas no existe o ha cambiado de dirección." noindex={true}>
  <article class="case" id="contenido">
    <nav class="case-nav"><a class="case-brand" href="/" aria-label="David Estévez Martínez, volver al inicio"><BrandMark teja="lima" /><span class="case-brand__return"><Icon name="back" /> Inicio</span></a><a href="mailto:david@estevezmartinez.es" data-contact-open>Hablemos <Icon name="plus" /></a></nav>
    <header class="case-intro">
      <p class="case-label">Error 404</p>
      <h1>Esta página<br /><em>no existe.</em></h1>
      <div class="case-lead"><h2>Puede que la dirección haya cambiado</h2><p>O que el enlace que has seguido esté roto. Desde el inicio llegas a todo: los proyectos, los servicios y la forma de contactar conmigo.</p></div>
    </header>
    <footer class="case-end">
      <p class="case-label">Sigamos.</p>
      <h2>¿Empezamos<br />por el principio?</h2>
      <a href="/">Ir al inicio <Icon name="back" /></a>
      <a href="/#proyectos">Ver los proyectos <ArrowUpRight /></a>
      <a href="mailto:david@estevezmartinez.es">Escríbeme <ArrowUpRight /></a>
    </footer>
  </article>
</Shell>
