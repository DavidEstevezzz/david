---
import Shell from '../layouts/Shell.astro';
import { homeSchema } from '../lib/schema';
import ServiceObject from '../components/ServiceObject.astro';
import BrandMark from '../components/BrandMark.astro';
import BrandSignature from '../components/BrandSignature.astro';
import Icon from '../components/Icon.astro';
const previews: Record<string, {src:string; width:number; height:number; url:string}> = {
  bomberos: {src:'/projects/bomberos/calendario.png', width:2880, height:1860, url:'gestion.bomberosgranada.es'},
  ecu: {src:'/projects/ecu/reprogramacion-codex.jpg', width:4000, height:2000, url:'JM Reprocars / Reprogramación'},
  wicontrol: {src:'/projects/covers/wicontrol-full.png', width:2592, height:1638, url:'WiControl / Panel de gestión'},
  'black-tides': {src:'/projects/black-tides/web-hero.jpg', width:4000, height:2000, url:'Black Tides / Draga’s Wake'},
  tagadona: {src:'/projects/tagadona/tagadona-home.jpg', width:2880, height:1800, url:'tagadonaracing.es'},
};
const projects = [
  { n: '01', title: 'Bomberos de Granada', kind: 'Software a medida', text: 'Guardias, cambios de turno, horas extras y recursos: una aplicación alrededor de la operativa del parque.', note: 'Coordinar personas y recursos.', href: '/proyectos/bomberos/', cover: 'bomberos' },
  { n: '02', title: 'Taller ECU · JMReprocars', kind: 'Web · Automatización', text: 'De una conversación a una solicitud organizada, con datos del vehículo y transferencia a atención humana.', note: 'De la consulta a la solicitud, automatizado.', href: '/proyectos/taller-ecu/', cover: 'ecu' },
  { n: '03', title: 'WiControl · Granjas conectadas', kind: 'Software · Dispositivos conectados', text: 'Gestión de granjas y dispositivos, seguimiento del peso y visualización de las condiciones ambientales.', note: 'Frontend y backend de una misma solución.', href: '/proyectos/wicontrol/', cover: 'wicontrol' },
  { n: '04', title: 'Black Tides: Draga’s Wake', kind: 'Frontend · Web de videojuego', text: 'Una presentación cinematográfica por capítulos, con escenas visuales y una experiencia guiada por el scroll.', note: 'Una web que se recorre como una historia.', href: '/proyectos/black-tides/', cover: 'black-tides' },
  { n: '05', title: 'Tagadona Racing', kind: 'Desarrollo web · Motor', text: 'Catálogo de motos, fichas de vehículos y una presencia digital orientada a la compraventa en Granada.', note: 'Conectar el catálogo con el cliente.', href: '/proyectos/tagadona/', cover: 'tagadona' },
];
import ArrowUpRight from '../components/ArrowUpRight.astro';
---
<Shell
  title="Desarrollo web y software a medida en Granada — David Estévez"
  description="Ingeniero informático freelance en Granada. Webs, aplicaciones de gestión y automatizaciones a medida para empresas. Cuéntame qué necesitas construir."
  schema={homeSchema()}
>
  <div class="home" data-home>
    <div class="journey" data-journey>
    <section class="story-stage" data-story-stage aria-label="De la idea a tus proyectos">
    <header class="home-nav">
      <a class="home-brand" href="/" data-nav aria-label="David Estévez Martínez, inicio"><BrandSignature teja="lima" /></a>
      <span class="nav-caption">Ingeniería digital independiente</span>
      <nav aria-label="Principal"><a href="#proyectos" data-skip-story>Proyectos</a><a href="mailto:david@estevezmartinez.es" data-contact-open>Hablemos <Icon name="plus" /></a></nav>
    </header>
    <a class="story-skip" href="#proyectos" data-skip-story>Saltar a proyectos <ArrowUpRight /></a>
      <div class="home-hero" id="contenido" tabindex="-1" data-hero-copy>
        <div class="hero-topline"><span><i></i> Desarrollo independiente</span><span>Granada, España · Para cualquier lugar</span></div>
        <h1>La idea es tuya.<br /><span>Hagámosla</span><br />real<span class="accent">.</span></h1>
        <div class="hero-bottom"><p>Desarrollo web, software de gestión<br />y automatizaciones a medida.</p><span class="round-link"><span>Desplaza. Esto empieza contigo.</span><b aria-hidden="true"><Icon name="down" /></b></span></div>
      </div>
      <div class="opening-copy" data-opening-copy aria-hidden="true"><span class="eyebrow">De la idea a la experiencia</span><p>Abre nuevas<br /> <em>posibilidades.</em></p></div>
      <div class="story-guide" aria-hidden="true"><div class="story-guide__line"><span data-story-progress></span></div><ol><li data-story-label data-active>01 <span>Una idea</span></li><li data-story-label>02 <span>Todo un mundo</span></li><li data-story-label>03 <span>Trabajo real</span></li></ol></div>
    </section>
    <div class="scene-source" data-scene-source>
      <article class="laptop-display" data-laptop-screen>
        <div class="display-frame">
        <div class="display-toolbar"><span class="display-brand"><BrandMark teja="tinta" label="DÉM" /></span><span>Software con sentido.</span><span>Granada / España</span></div>
        <div class="display-body"><span class="display-eyebrow">Diseñado para tu forma de trabajar</span><h2>Lo que imaginas.<br /><em>Lo que construimos.</em></h2><p>Del primer boceto a la herramienta<br />que usas cada día.</p>
          <div class="display-services"><div><span>01 / SOFTWARE</span><strong>Tu equipo.<br />Tus herramientas.</strong></div><div><span>02 / WEB</span><strong>Experiencias<br />que conectan.</strong></div><div><span>03 / AUTOMATIZACIÓN</span><strong>Menos tareas.<br />Más posibilidades.</strong></div></div>
        </div><div class="display-footer"><span>Ingeniería independiente</span><span>Explora el trabajo <Icon name="down" /></span></div>
        </div>
      </article>
      <article class="project-surface project-surface--management" data-project-surface>
        <div class="surface-meta"><span>01 / SOFTWARE A MEDIDA</span><span><Icon name="software" /></span></div>
        <ServiceObject kind="software" />
        <div class="surface-copy"><span class="surface-location">Adaptado a cada negocio</span><h2>Software que<br /> encaja contigo.</h2><p>Aplicaciones de gestión, herramientas internas y soluciones a medida para cualquier sector. Adaptadas a tus procesos y preparadas para crecer.</p></div>
        <div class="surface-bottom"><span>Tu negocio define la herramienta.</span><span>01 — 03</span></div>
      </article>
      <article class="project-surface project-surface--web" data-project-surface>
        <div class="surface-meta"><span>02 / DESARROLLO WEB</span><span><Icon name="web" /></span></div>
        <ServiceObject kind="web" />
        <div class="surface-copy"><span class="surface-location">De la primera visita a la compra</span><h2>Tu negocio,<br /> en la web.</h2><p>Webs corporativas, tiendas online, plataformas y aplicaciones web. Desde una presencia digital cuidada hasta una experiencia a medida.</p></div>
        <div class="surface-bottom"><span>Presentar. Vender. Interactuar.</span><span>02 — 03</span></div>
      </article>
      <article class="project-surface project-surface--automation" data-project-surface>
        <div class="surface-meta"><span>03 / AUTOMATIZACIÓN</span><span><Icon name="automation" /></span></div>
        <ServiceObject kind="automation" />
        <div class="surface-copy"><span class="surface-location">Tus herramientas, trabajando juntas</span><h2>Conecta.<br /> Automatiza.</h2><p>Conexión de servicios, orquestación de procesos, bots de WhatsApp y atención telefónica automatizada. Menos tareas manuales, más tiempo para tu negocio.</p></div>
        <div class="surface-bottom"><span>De tareas sueltas a procesos conectados.</span><span>03 — 03</span></div>
      </article>
    </div>
    </div>
    <section class="work-section" id="proyectos" tabindex="-1">
      <div class="section-kicker"><span>03 — Trabajo seleccionado</span><span>Web / Software / Automatización</span></div>
      <div class="work-heading"><h2>Ideas que ya<br /><em>están en marcha.</em></h2><p>Cada proyecto parte de una necesidad distinta. La solución también.</p></div>
      <div class="work-grid">
        {projects.map(project => <article class="work-card" id={`proyecto-${project.href.split('/')[2]}`}>
          <a class="work-card-art" href={`${project.href}#vista-proyecto`} aria-label={`Explorar ${project.title}`}>
            <span class="work-preview-bar" aria-hidden="true"><i></i><i></i><i></i><span>{previews[project.cover].url}</span></span>
            <img src={previews[project.cover].src} width={previews[project.cover].width} height={previews[project.cover].height} loading="lazy" alt="" data-project-image={project.href.split('/')[2]} />
            <span class="work-preview-open" aria-hidden="true"><ArrowUpRight /></span>
          </a>
          <div class="work-card-info">
          <div class="work-card-meta"><span>{project.n} / {project.kind}</span><span aria-hidden="true"><ArrowUpRight /></span></div>
          <h3>{project.title}</h3><p>{project.text}</p>
          <div class="work-card-foot"><span>{project.note}</span>{project.href && <a href={project.href}>Ver proyecto <span class="sr-only">{project.title}</span> <ArrowUpRight /></a>}</div>
          </div>
        </article>)}
      </div>
      <p class="work-note">Cinco proyectos, distintas formas de resolver una necesidad. Todas las fichas están abiertas: entra en la que te interese.</p>
    </section>
    <section class="contact-section" id="contacto" tabindex="-1">
      <div class="contact-signature"><BrandSignature teja="tinta" role /><span>De la idea a lo real.</span></div>
      <div class="section-kicker"><span>El siguiente proyecto</span><span>Podría ser el tuyo <Icon name="down" /></span></div>
      <h2>¿Qué tienes<br /><em>en mente?</em></h2>
      <div class="contact-bottom"><p>Soy David, ingeniero informático.<br />Cuéntame qué necesitas construir.</p><div class="contact-channels"><a class="contact-link" href="mailto:david@estevezmartinez.es">david@estevezmartinez.es <span aria-hidden="true"><ArrowUpRight /></span></a><a href="https://wa.me/34609662376" class="whatsapp-link" target="_blank" rel="noopener noreferrer">Hablamos por WhatsApp <ArrowUpRight /></a></div></div>
    </section>
    <footer class="home-footer"><BrandMark teja="lima" label="DÉM" /><span>© {new Date().getFullYear()}</span><a href="/lab/morph/" data-nav rel="nofollow">Laboratorio de movimiento <ArrowUpRight /></a><button class="text-button" data-motion-toggle hidden>Usar vista estática</button><span>Hecho desde Granada.</span></footer>
  </div>
</Shell>
