---
import Shell from '../layouts/Shell.astro';
const projects = [
  { n: '01', title: 'Bomberos de Granada', kind: 'Software a medida', text: 'Guardias, cambios de turno, horas extras y recursos: una aplicación alrededor de la operativa del parque.', note: 'Coordinar personas y recursos.', href: '/proyectos/bomberos/', mark: '24 / 7' },
  { n: '02', title: 'Taller ECU · JMReprocars', kind: 'Automatización · WhatsApp', text: 'De una conversación a una solicitud organizada, con datos del vehículo y transferencia a atención humana.', note: 'Automatización en desarrollo.', href: '/proyectos/taller-ecu/', mark: '↳ ECU' },
  { n: '03', title: 'WiControl · Granjas conectadas', kind: 'Software · Dispositivos conectados', text: 'Gestión de granjas y dispositivos, seguimiento del peso y visualización de las condiciones ambientales.', note: 'Frontend y backend de una misma solución.', href: '', mark: '≈ Wi' },
  { n: '04', title: 'Black Tides: Draga’s Wake', kind: 'Frontend · Web de videojuego', text: 'Una presentación cinematográfica por capítulos, con escenas visuales y una experiencia guiada por el scroll.', note: 'Experiencia web en desarrollo.', href: '', mark: 'BT /' },
  { n: '05', title: 'Tagadona Racing', kind: 'Desarrollo web · Motor', text: 'Catálogo de motos, fichas de vehículos y una presencia digital orientada a la compraventa en Granada.', note: 'Conectar el catálogo con el cliente.', href: '', mark: '↗ TR' },
];
---
<Shell title="David — Desarrollo web, software y automatización" description="Ingeniero informático en Granada. Desarrollo web, software de gestión y automatizaciones a medida para empresas.">
  <div class="home" data-home>
    <div class="journey" data-journey>
    <section class="story-stage" data-story-stage aria-label="De la idea a tus proyectos">
    <header class="home-nav">
      <a class="home-brand" href="/" data-nav aria-label="David, inicio">d<span>↗</span></a>
      <span class="nav-caption">David / Ingeniero informático</span>
      <nav aria-label="Principal"><a href="#proyectos" data-skip-story>Proyectos</a><a href="#contacto" data-skip-story>Hablemos <span aria-hidden="true">↗</span></a></nav>
    </header>
    <a class="story-skip" href="#proyectos" data-skip-story>Saltar a proyectos ↗</a>
      <div class="home-hero" id="contenido" tabindex="-1" data-hero-copy>
        <div class="hero-topline"><span><i></i> Desarrollo independiente</span><span>Granada, España · Para cualquier lugar</span></div>
        <h1>La idea es tuya.<br /><span>Hagámosla</span><br />real<span class="accent">.</span></h1>
        <div class="hero-bottom"><p>Desarrollo web, software de gestión<br />y automatizaciones a medida.</p><span class="round-link"><span>Desplaza. Esto empieza contigo.</span><b aria-hidden="true">↓</b></span></div>
      </div>
      <div class="opening-copy" data-opening-copy aria-hidden="true"><span class="eyebrow">De la idea a la experiencia</span><p>Abre nuevas<br /> <em>posibilidades.</em></p></div>
      <div class="story-guide" aria-hidden="true"><div class="story-guide__line"><span data-story-progress></span></div><ol><li data-story-label data-active>01 <span>Una idea</span></li><li data-story-label>02 <span>Todo un mundo</span></li><li data-story-label>03 <span>Trabajo real</span></li></ol></div>
    </section>
    <div class="scene-source" data-scene-source>
      <article class="laptop-display" data-laptop-screen>
        <div class="display-toolbar"><span class="display-brand">d↗</span><span>Software con sentido.</span><span>Granada / España</span></div>
        <div class="display-body"><span class="display-eyebrow">Diseñado para tu forma de trabajar</span><h2>Lo que imaginas.<br /><em>Lo que construimos.</em></h2><p>Del primer boceto a la herramienta<br />que usas cada día.</p>
          <div class="display-services"><div><span>01 / WEB</span><strong>Experiencias<br />que conectan.</strong></div><div><span>02 / SOFTWARE</span><strong>Tu equipo.<br />Tus herramientas.</strong></div><div><span>03 / AUTOMATIZACIÓN</span><strong>Menos tareas.<br />Más posibilidades.</strong></div></div>
        </div><div class="display-footer"><span>David · Ingeniería informática</span><span>Explora el trabajo ↓</span></div>
      </article>
      <article class="project-surface project-surface--management" data-project-surface>
        <div class="surface-meta"><span>01 / SOFTWARE A MEDIDA</span><span>↗</span></div>
        <div class="surface-symbol" aria-hidden="true">&#123;<span>+</span>&#125;</div>
        <div class="surface-copy"><span class="surface-location">Adaptado a cada negocio</span><h2>Software que<br />encaja contigo.</h2><p>Aplicaciones de gestión, herramientas internas y soluciones a medida para cualquier sector. Adaptadas a tus procesos y preparadas para crecer.</p></div>
        <div class="surface-bottom"><span>Tu negocio define la herramienta.</span><span>01 — 03</span></div>
      </article>
      <article class="project-surface project-surface--web" data-project-surface>
        <div class="surface-meta"><span>02 / DESARROLLO WEB</span><span>↗</span></div>
        <div class="surface-symbol" aria-hidden="true">&lt;<span>/</span>&gt;</div>
        <div class="surface-copy"><span class="surface-location">De la primera visita a la compra</span><h2>Tu negocio,<br />en la web.</h2><p>Webs corporativas, tiendas online, plataformas y aplicaciones web. Desde una presencia digital cuidada hasta una experiencia a medida.</p></div>
        <div class="surface-bottom"><span>Presentar. Vender. Interactuar.</span><span>02 — 03</span></div>
      </article>
      <article class="project-surface project-surface--automation" data-project-surface>
        <div class="surface-meta"><span>03 / AUTOMATIZACIÓN</span><span>↗</span></div>
        <div class="surface-symbol" aria-hidden="true">[<span>↗</span>]</div>
        <div class="surface-copy"><span class="surface-location">Tus herramientas, trabajando juntas</span><h2>Conecta.<br />Automatiza.</h2><p>Conexión de servicios, orquestación de procesos, bots de WhatsApp y atención telefónica automatizada. Menos tareas manuales, más tiempo para tu negocio.</p></div>
        <div class="surface-bottom"><span>De tareas sueltas a procesos conectados.</span><span>03 — 03</span></div>
      </article>
    </div>
    </div>
    <section class="work-section" id="proyectos" tabindex="-1">
      <div class="section-kicker"><span>03 — Trabajo seleccionado</span><span>Web / Software / Automatización</span></div>
      <div class="work-heading"><h2>Ideas que ya<br /><em>están en marcha.</em></h2><p>Cada proyecto parte de una necesidad distinta. La solución también.</p></div>
      <div class="work-grid">
        {projects.map(project => <article class="work-card">
          <div class="work-card-meta"><span>{project.n} / {project.kind}</span><span aria-hidden="true">↗</span></div>
          <div class="work-card-art" aria-hidden="true">{project.n === '01' ? <img src="/projects/bomberos/calendario.png" width="2880" height="1860" loading="lazy" alt="" /> : <span>{project.mark}</span>}</div>
          <h3>{project.title}</h3><p>{project.text}</p>
          <div class="work-card-foot"><span>{project.note}</span>{project.href && <a href={project.href}>Ver proyecto <span class="sr-only">{project.title}</span> ↗</a>}</div>
        </article>)}
      </div>
      <p class="work-note">Cinco proyectos, distintas formas de resolver una necesidad. Explora las primeras fichas de Bomberos y Taller ECU.</p>
    </section>
    <section class="contact-section" id="contacto" tabindex="-1">
      <div class="section-kicker"><span>El siguiente proyecto</span><span>Podría ser el tuyo ↙</span></div>
      <h2>¿Qué tienes<br /><em>en mente?</em></h2>
      <div class="contact-bottom"><p>Soy David, ingeniero informático.<br />Cuéntame qué necesitas construir.</p><div class="contact-channels"><a class="contact-link" href="mailto:david@estevezmartinez.com">david@estevezmartinez.com <span aria-hidden="true">↗</span></a><a href="https://wa.me/34609662376" class="whatsapp-link" target="_blank" rel="noopener noreferrer">Hablamos por WhatsApp ↗</a></div></div>
    </section>
    <footer class="home-footer"><span>David © {new Date().getFullYear()}</span><a href="/lab/morph" data-nav>Laboratorio de movimiento ↗</a><button class="text-button" data-motion-toggle hidden>Usar vista estática</button><span>Hecho desde Granada.</span></footer>
  </div>
</Shell>
